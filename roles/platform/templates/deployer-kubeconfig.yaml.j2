apiVersion: v1
kind: Config
clusters:
  - name: contabo
    cluster:
      server: https://{{ ansible_host }}:6443
      certificate-authority-data: {{ platform_deployer_ca.stdout }}
users:
  - name: deployer
    user:
      token: {{ platform_deployer_token.stdout | b64decode }}
contexts:
  - name: {{ tenant.name }}
    context:
      cluster: contabo
      user: deployer
      namespace: {{ tenant.name }}
current-context: {{ tenant.name }}
